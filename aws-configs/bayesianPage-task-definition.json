{
  "family": "bayesian-simulation-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "4096",
  "memory": "8192",
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/BayesianSimulationFargateTaskRole",
  "containerDefinitions": [
    {
      "name": "bayesian-simulation-app",
      "image": "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${BBN_ECR_REPOSITORY}:${DOCKER_IMAGE_TAG}",
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/bayesian-simulation-task",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "environment": [
        {
          "name": "AWS_REGION",
          "value": "${AWS_REGION}"
        },
        {
          "name": "JOBS_TABLE_NAME",
          "value": "BayesianSimulationJobs"
        },
        {
          "name": "S3_BUCKET_NAME",
          "value": "${BBN_S3_BUCKET_NAME}"
        },
        {
          "name": "TEST_MODE",
          "value": "false"
        }
      ]
    }
  ]
}

